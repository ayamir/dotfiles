abbr "sz"="source ~/.zshrc"
abbr "vz"="nvim ~/.zshrc"
abbr "nv"="nvim"
abbr "lg"="lazygit"
abbr "mkdir"="mkdir -p"
abbr "grep"="grep --color=auto"
abbr "ports"="lsof -iTCP -sTCP:LISTEN -P -n"
abbr "path"="print -r -l -- \$path"
abbr "..."="cd ../.."
abbr "...."="cd ../../.."
abbr "gs"="git status -sb"
abbr "ga"="git add"
abbr "gc"="git commit"
abbr "gcm"="git commit -m"
abbr "gco"="git checkout"
abbr "gb"="git branch"
abbr "glog"="git log --oneline --graph --decorate --all"
abbr "gd"="git diff"
abbr "gst"="git stash"
abbr "gps"="git ps"
abbr "gpl"="git pl"
abbr "py"="python3"
abbr "pyins"="pip3 install --user"
abbr "pyuins"="pip3 uninstall"
abbr "ins"="brew install"
abbr "uins"="brew uninstall"
abbr "up"="brew update && brew upgrade"
abbr "c"="brew cleanup"
abbr "lsb"="brew list"
abbr "reins"="brew reinstall"
abbr "cin"="brew info"
abbr "srb"="brew search"
abbr "ls"="eza --group-directories-first"
abbr "ll"="eza -lh --git --group-directories-first"
abbr "la"="eza -lah --git --group-directories-first"
abbr "lt"="eza --tree --level=2"
abbr "l"="eza --group-directories-first -CF"
abbr "cat"="bat -pp"
abbr "ne"="fastfetch"
