# ============================================================
#  ~/.zshrc  —  极简实用 zsh 配置（原生零依赖，工具可选增强）
# ============================================================

# ---------- 基本 ----------
export LANG=${LANG:-en_US.UTF-8}
export EDITOR=${EDITOR:-nvim}
export VISUAL=$EDITOR
export PAGER=${PAGER:-less}
export LESS='-R -F -X -i -M'
export CLICOLOR=1

# 历史记录
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt EXTENDED_HISTORY        # 记录时间戳与耗时
setopt INC_APPEND_HISTORY      # 实时写入，多终端共享
setopt SHARE_HISTORY           # 多终端历史互通
setopt HIST_IGNORE_DUPS        # 忽略重复
setopt HIST_IGNORE_SPACE       # 空格开头的命令不记录
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY             # 展开历史命令前先确认

# 目录跳转/补全行为
setopt AUTO_CD                 # 直接输入目录名即可进入
setopt AUTO_PUSHD              # cd 自动入栈
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt INTERACTIVE_COMMENTS    # 交互式支持 # 注释
setopt NO_BEEP

# ---------- 补全 ----------
# 让 brew 提供的补全（zoxide 等）进入 fpath，须在 compinit 之前
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)
autoload -Uz compinit && compinit -C   # -C 跳过安全检查，启动更快
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'  # 大小写不敏感
zstyle ':completion:*' list-colors ''        # 彩色补全
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.cache/zsh/compcache
zstyle ':completion:*:descriptions' format '%F{yellow}%d%f'
zstyle ':completion:*:sudo:*' command-path /usr/local/sbin /usr/sbin /sbin \
  /opt/homebrew/bin /usr/local/bin /usr/bin /bin

# ---------- 提示符 ----------
# 由 Cobalt Spark 主题接管（见文件末尾的 source）

# ---------- 缩写（zsh-abbr；定义在 ~/.config/zsh-abbr/user-abbreviations，加载快且静默）----------
source ~/.local/share/zsh-abbr/zsh-abbr.plugin.zsh

# ---------- 函数 ----------
mkcd() { mkdir -p "$@" && cd "$_" }

# 解压常见格式（配合 alias x）
extract() {
  local file="$1"
  case "$file" in
    *.tar.bz2) tar xjf "$file"    ;;
    *.tar.gz)  tar xzf "$file"    ;;
    *.tar.xz)  tar xJf "$file"    ;;
    *.tar.zst) tar --zstd -xf "$file" ;;
    *.tar)     tar xf  "$file"    ;;
    *.bz2)     bunzip2 "$file"    ;;
    *.gz)      gunzip  "$file"    ;;
    *.zip)     unzip   "$file"    ;;
    *.7z)      7z x    "$file"    ;;
    *.rar)     unar -o . "$file" ;;
    *.zst)     zstd -d "$file"    ;;
    *)         echo "不支持的格式: $file" ;;
  esac
}

# ---------- 工具增强（存在才生效）----------
# ls/ll/la/lt/l/cat 的缩写已移入 ~/.config/zsh-abbr/user-abbreviations（默认用 eza/bat）
command -v delta >/dev/null && \
  export GIT_PAGER='delta' PAGER='delta'

# fzf：Ctrl-R 历史搜索 / Ctrl-T 文件 / Alt-C 目录
if command -v fzf >/dev/null; then
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --inline-info'
  if command -v fd >/dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  fi
  # fzf >= 0.48 推荐方式，自动处理补全与快捷键
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    for f in /opt/homebrew/opt/fzf/shell/completion.zsh \
             /usr/share/fzf/completion.zsh \
             ~/.fzf/shell/completion.zsh; do
      [[ -r $f ]] && source $f && break
    done
    for f in /opt/homebrew/opt/fzf/shell/key-bindings.zsh \
             /usr/share/fzf/key-bindings.zsh \
             ~/.fzf/shell/key-bindings.zsh; do
      [[ -r $f ]] && source $f && break
    done
  fi
fi

# fzf-tab：用 fzf 做 Tab 补全（须在 fzf 之后加载）
if command -v fzf >/dev/null && [[ -r /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh ]]; then
  source /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh
  # < / > 切换补全分组
  zstyle ':fzf-tab:*' switch-group '<' '>'
  # cd 补全时用 eza 预览目录内容
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
fi

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v direnv  >/dev/null && eval "$(direnv hook zsh)"

# mise：多语言版本管理（Node/Python/Ruby/Go 等），需在 compinit 之后激活以便补全
if command -v mise >/dev/null; then
  export MISE_YES=1                 # 自动信任配置，少一次确认
  eval "$(mise activate zsh)"
fi

# atuin：现代历史记录（接管 Ctrl-R；须在 autosuggestions 之前加载，以便用 atuin 做建议）
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow --disable-ai)"

# 语法高亮 + 自动建议（需自行安装，放最后 source）
for f in /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
         /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r $f ]] && source $f && break
done
for f in /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh; do
  [[ -r $f ]] && source $f && break
done

# 自动配对括号/引号
[[ -r /opt/homebrew/share/zsh-autopair/autopair.zsh ]] && source /opt/homebrew/share/zsh-autopair/autopair.zsh

# Homebrew
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ---------- PATH 设置 ----------
typeset -U path  # 自动去重

# 目录存在才加入 PATH；$2 为 append 时追加，否则前置
add_to_path() {
  [[ -d "$1" ]] || return 0
  if [[ "$2" == append ]]; then
    path+=("$1")
  else
    path=("$1" $path)
  fi
}

# 高优先级（前置）；列表越靠后，最终优先级越高
for d in \
  /usr/local/bin \
  /usr/local/sbin \
  ~/.cargo/bin \
  ~/.local/share/mise/shims \
  ~/.local/bin; do
  add_to_path "$d"
done

# 约定目录：即使暂不存在也加入，go install / 手动放脚本后无需重载 shell
path=(~/go/bin ~/bin $path)

# 低优先级（追加）
for d in \
  ~/.local/share/pnpm \
  ~/.deno/bin \
  ~/.bun/bin \
  ~/.yarn/bin \
  ~/.config/yarn/global/node_modules/.bin \
  /opt/local/bin \
  /opt/local/sbin \
  /Library/Developer/CommandLineTools/usr/bin; do
  add_to_path "$d" append
done

# pip --user（目录随 Python 版本变化，通配符动态加入）
for d in ~/Library/Python/*/bin(N); do
  add_to_path "$d" append
done

# ---------- Cobalt Spark 提示符主题（Fork：github.com/ayamir/cobalt-spark）----------
# 选项（必须在 source 之前设置）
COBALT_SPARK_THEME_GIT_HIDDEN_PREFIXES=(feature feat fix)

source ~/clone/cobalt-spark/cobalt-spark.plugin.zsh

# Ctrl+X Ctrl+P 复制当前目录
bindkey -M emacs '^X^P' cobalt-spark-copy-cwd
